# Скопировать в .env рядом и заполнить: cp .env.example .env
# Сам .env в git не попадает. Здесь только имена и безопасные значения.

# Токен бота от @BotFather. Бот у канала свой и отдельный: он носит внутренности
# проектов владельца, и мешать его с ботами продуктов нельзя.
BOT_TOKEN=

# Секрет, которым система доказывает каналу, что запрос от неё. Любая длинная
# случайная строка, например: openssl rand -hex 32
FORGE_SECRET=

# Числовой id чата владельца. Сообщения от любого другого чата канал игнорирует
# молча. Узнать свой id: написать боту и посмотреть логи канала, либо @userinfobot.
OWNER_CHAT_ID=

# Пароль к своей базе проекта (у каждого проекта на сервере свой Postgres).
POSTGRES_PASSWORD=

# Порт, на котором канал слушает. Свободный на твоём хосте; на своей же машине
# годится значение по умолчанию.
API_HOST_PORT=8090
